{
  "name": "nbpix",
  "version": "0.1.0",
  "private": true,
  "description": "Une sous-couche de sprite à partir d'une image, au format de NayosBeat.",
  "type": "module",
  "scripts": {
    "dev": "npm run model && vite --open",
    "model": "node --import ./tools/ts-imports.js src/model.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "onnxruntime-web": "^1.31.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
